<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One inherited form per albaha model, adding its own log thread.
         Every one of these forms has a <sheet> and only three have a
         <notebook>, so the page is appended into //sheet uniformly rather than
         special-casing three of them. Read-only: notes are appended, never
         edited (see albaha.record.log.write/unlink). -->

    <record id="view_albaha_budget_form_log" model="ir.ui.view">
        <field name="name">albaha.budget.form.log</field>
        <field name="model">albaha.budget</field>
        <field name="inherit_id" ref="albaha_pmo_finance.view_albaha_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="السجل" name="albaha_log">
                    <field name="log_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="create_date" string="التاريخ"/>
                            <field name="user_id" string="بواسطة"/>
                            <field name="note" string="الملاحظة"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

