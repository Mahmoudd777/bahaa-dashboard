<odoo>
    <record id="view_albaha_procurement_list" model="ir.ui.view">
        <field name="name">albaha.procurement.list</field>
        <field name="model">albaha.procurement</field>
        <field name="arch" type="xml">
            <list string="Procurements">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="tender_ref_etimad"/>
                <field name="procurement_type"/>
                <field name="stage"/>
                <field name="estimated_value_sar_m"/>
                <field name="awarded_value_sar_m"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_procurement_form" model="ir.ui.view">
        <field name="name">albaha.procurement.form</field>
        <field name="model">albaha.procurement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="project_id"/>
                        <field name="tender_ref_etimad"/>
                        <field name="procurement_type"/>
                        <field name="stage"/>
                        </group>
                        <group>
                        <field name="estimated_value_sar_m"/>
                        <field name="awarded_value_sar_m"/>
                        <field name="rfp_floated_date"/>
                        <field name="expected_award_date"/>
                        <field name="awarded_supplier"/>
                        <field name="cycle_time_days"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_procurement_search" model="ir.ui.view">
        <field name="name">albaha.procurement.search</field>
        <field name="model">albaha.procurement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="tender_ref_etimad"/>
                <group>
                    <filter string="Project" name="gb_project_id" context="{'group_by':'project_id'}"/>
                    <filter string="Procurement Type" name="gb_procurement_type" context="{'group_by':'procurement_type'}"/>
                    <filter string="Stage" name="gb_stage" context="{'group_by':'stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_procurement" model="ir.actions.act_window">
        <field name="name">Procurements</field>
        <field name="res_model">albaha.procurement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_procurement" name="Procurements" parent="menu_albaha_pmo_finance_root" action="action_albaha_procurement"/>
</odoo>
