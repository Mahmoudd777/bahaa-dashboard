<odoo>
    <record id="view_albaha_contract_list" model="ir.ui.view">
        <field name="name">albaha.contract.list</field>
        <field name="model">albaha.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="procurement_id"/>
                <field name="supplier_id"/>
                <field name="contract_value_sar_m"/>
                <field name="currency"/>
                <field name="signed_date"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_contract_form" model="ir.ui.view">
        <field name="name">albaha.contract.form</field>
        <field name="model">albaha.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="procurement_id"/>
                        <field name="supplier_id"/>
                        <field name="contract_value_sar_m"/>
                        <field name="currency"/>
                        <field name="signed_date"/>
                        </group>
                        <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="performance_guarantee_pct"/>
                        <field name="extensions_count"/>
                        <field name="status"/>
                        </group>
                    </group>
                    <group string="SLA Terms">
                        <field name="sla_terms" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_contract_search" model="ir.ui.view">
        <field name="name">albaha.contract.search</field>
        <field name="model">albaha.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="procurement_id"/>
                <field name="supplier_id"/>
                <field name="currency"/>
                <group>
                    <filter string="Procurement" name="gb_procurement_id" context="{'group_by':'procurement_id'}"/>
                    <filter string="Supplier" name="gb_supplier_id" context="{'group_by':'supplier_id'}"/>
                    <filter string="Status" name="gb_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">albaha.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_contract" name="Contracts" parent="menu_albaha_pmo_finance_root" action="action_albaha_contract"/>
</odoo>
