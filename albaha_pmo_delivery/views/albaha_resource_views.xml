<odoo>
    <record id="view_albaha_resource_list" model="ir.ui.view">
        <field name="name">albaha.resource.list</field>
        <field name="model">albaha.resource</field>
        <field name="arch" type="xml">
            <list string="Resources">
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role_on_project"/>
                <field name="allocation_pct"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="billable_rate_sar_hr"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_resource_form" model="ir.ui.view">
        <field name="name">albaha.resource.form</field>
        <field name="model">albaha.resource</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="employee_id"/>
                        <field name="role_on_project"/>
                        <field name="allocation_pct"/>
                        </group>
                        <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="billable_rate_sar_hr"/>
                        <field name="utilization_actual"/>
                        <field name="conflict_flag"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_resource_search" model="ir.ui.view">
        <field name="name">albaha.resource.search</field>
        <field name="model">albaha.resource</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role_on_project"/>
                <group>
                    <filter string="Project" name="gb_project_id" context="{'group_by':'project_id'}"/>
                    <filter string="Employee" name="gb_employee_id" context="{'group_by':'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">albaha.resource</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_resource" name="Resources" parent="menu_albaha_pmo_delivery_root" action="action_albaha_resource"/>
</odoo>
