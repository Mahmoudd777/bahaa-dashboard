<odoo>
    <record id="view_albaha_closure_list" model="ir.ui.view">
        <field name="name">albaha.closure.list</field>
        <field name="model">albaha.closure</field>
        <field name="arch" type="xml">
            <list string="Closures">
                <field name="name"/>
                <field name="project_id"/>
                <field name="official_closure_date"/>
                <field name="final_progress_pct"/>
                <field name="final_cost"/>
                <field name="budget_variance_pct"/>
                <field name="schedule_variance_days"/>
                <field name="benefits_realization_pct"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_closure_form" model="ir.ui.view">
        <field name="name">albaha.closure.form</field>
        <field name="model">albaha.closure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="official_closure_date"/>
                        <field name="final_progress_pct"/>
                        <field name="final_cost"/>
                        <field name="budget_variance_pct"/>
                        </group>
                        <group>
                        <field name="schedule_variance_days"/>
                        <field name="benefits_realization_pct"/>
                        <field name="closure_type"/>
                        <field name="sponsor_signoff"/>
                        <field name="archive_ref"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_closure_search" model="ir.ui.view">
        <field name="name">albaha.closure.search</field>
        <field name="model">albaha.closure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="archive_ref"/>
                <group>
                    <filter string="Project" name="gb_project_id" context="{'group_by':'project_id'}"/>
                    <filter string="Closure Type" name="gb_closure_type" context="{'group_by':'closure_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_closure" model="ir.actions.act_window">
        <field name="name">Closures</field>
        <field name="res_model">albaha.closure</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_closure" name="Closures" parent="menu_albaha_pmo_governance_root" action="action_albaha_closure"/>
</odoo>
