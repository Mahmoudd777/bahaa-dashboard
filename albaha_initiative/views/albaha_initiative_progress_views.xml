<odoo>
    <!-- Form View -->
    <record id="view_albaha_initiative_progress_form" model="ir.ui.view">
        <field name="name">albaha.initiative.progress.form</field>
        <field name="model">albaha.initiative.progress</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Reference &amp; Period">
                            <field name="name"/>
                            <field name="period"/>
                        </group>
                        <group string="Progress Metrics">
                            <field name="progress_pct"/>
                            <field name="milestones_completed"/>
                            <field name="milestones_total"/>
                            <field name="budget_consumed_pct"/>
                            <field name="rag_status"/>
                        </group>
                    </group>
                    <group string="Reporting Details">
                        <field name="reported_by"/>
                        <field name="reported_date"/>
                    </group>
                    <notebook>
                        <page string="Narrative">
                            <field name="narrative" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_albaha_initiative_progress_tree" model="ir.ui.view">
        <field name="name">albaha.initiative.progress.list</field>
        <field name="model">albaha.initiative.progress</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="period"/>
                <field name="progress_pct"/>
                <field name="rag_status"/>
                <field name="reported_date"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_albaha_initiative_progress_search" model="ir.ui.view">
        <field name="name">albaha.initiative.progress.search</field>
        <field name="model">albaha.initiative.progress</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <filter string="Active Reports" name="active_reports" domain="[('reported_date', '>=', context_today())]"/>
                </group>
                <group>
                    <field name="initiative_id"/>
                    <filter string="By Period" name="by_period"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and Menu -->
    <record id="action_albaha_initiative_progress" model="ir.actions.act_window">
        <field name="name">Progress</field>
        <field name="res_model">albaha.initiative.progress</field>
        <field name="view_mode">list</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_albaha_progress_parent" name="Progress" parent="menu_albaha_initiative_parent" action="action_albaha_initiative_progress" sequence="20"/>
</odoo>
