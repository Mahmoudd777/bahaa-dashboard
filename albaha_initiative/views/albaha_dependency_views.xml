<odoo>
    <record id="view_albaha_dependency_list" model="ir.ui.view">
        <field name="name">albaha.dependency.list</field>
        <field name="model">albaha.dependency</field>
        <field name="arch" type="xml">
            <list string="Dependencies">
                <field name="name"/>
                <field name="source_initiative_id"/>
                <field name="target_initiative_id"/>
                <field name="dependency_type"/>
                <field name="criticality"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_dependency_form" model="ir.ui.view">
        <field name="name">albaha.dependency.form</field>
        <field name="model">albaha.dependency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Link">
                            <field name="name"/>
                            <field name="source_initiative_id"/>
                            <field name="target_initiative_id"/>
                            <field name="dependency_type"/>
                        </group>
                        <group string="Assessment">
                            <field name="criticality"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_dependency_search" model="ir.ui.view">
        <field name="name">albaha.dependency.search</field>
        <field name="model">albaha.dependency</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_initiative_id"/>
                <field name="target_initiative_id"/>
                <group>
                    <filter string="Type" name="gb_type" context="{'group_by':'dependency_type'}"/>
                    <filter string="Criticality" name="gb_crit" context="{'group_by':'criticality'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_dependency" model="ir.actions.act_window">
        <field name="name">Dependencies</field>
        <field name="res_model">albaha.dependency</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_dependency" name="Dependencies" parent="menu_albaha_root"
              action="action_albaha_dependency" sequence="40"/>
</odoo>
