<odoo>
    <record id="view_albaha_investment_opportunity_list" model="ir.ui.view">
        <field name="name">albaha.investment.opportunity.list</field>
        <field name="model">albaha.investment.opportunity</field>
        <field name="arch" type="xml">
            <list string="Investment Opportunities">
                <field name="number"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="jobs_direct" sum="Direct"/>
                <field name="jobs_indirect" sum="Indirect"/>
                <field name="gdp_contribution_sar_m" sum="GDP"/>
                <field name="npv_sar_m" sum="NPV"/>
                <field name="irr_pct"/>
                <field name="payback_years"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_investment_opportunity_form" model="ir.ui.view">
        <field name="name">albaha.investment.opportunity.form</field>
        <field name="model">albaha.investment.opportunity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="name"/>
                            <field name="program_id"/>
                            <field name="initiative_id"/>
                        </group>
                        <group>
                            <field name="source_reference"/>
                            <field name="jobs_total"/>
                        </group>
                    </group>
                    <group string="Expected Impact by 2030">
                        <group>
                            <field name="visitors_k"/>
                            <field name="jobs_direct"/>
                        </group>
                        <group>
                            <field name="jobs_indirect"/>
                            <field name="gdp_contribution_sar_m"/>
                        </group>
                    </group>
                    <group string="Financial Case">
                        <group>
                            <field name="npv_sar_m"/>
                            <field name="irr_pct"/>
                        </group>
                        <group>
                            <field name="payback_years"/>
                        </group>
                    </group>
                    <group string="Revenue (SAR m)">
                        <group>
                            <field name="revenue_2028_sar_m"/>
                            <field name="revenue_2029_sar_m"/>
                            <field name="revenue_2030_sar_m"/>
                        </group>
                        <group>
                            <field name="revenue_2031_sar_m"/>
                            <field name="revenue_2032_sar_m"/>
                        </group>
                    </group>
                    <group string="Overview">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_albaha_investment_opportunity" model="ir.actions.act_window">
        <field name="name">Investment Opportunities</field>
        <field name="res_model">albaha.investment.opportunity</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_investment_opportunity"
        name="Investment Opportunities"
        parent="albaha_strategy.menu_albaha_root"
        action="action_albaha_investment_opportunity"
        sequence="45"/>
</odoo>
