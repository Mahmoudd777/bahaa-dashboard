<odoo>
    <record id="view_albaha_sector_kpi_list" model="ir.ui.view">
        <field name="name">albaha.sector.kpi.list</field>
        <field name="model">albaha.sector.kpi</field>
        <field name="arch" type="xml">
            <list string="Sector KPIs">
                <field name="domain"/>
                <field name="sector_id"/>
                <field name="period"/>
                <field name="indicator"/>
                <field name="value"/>
                <field name="target"/>
                <field name="unit"/>
                <field name="rag_status"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_sector_kpi_form" model="ir.ui.view">
        <field name="name">albaha.sector.kpi.form</field>
        <field name="model">albaha.sector.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Classification">
                            <field name="domain"/>
                            <field name="sector_id"/>
                            <field name="period"/>
                            <field name="indicator"/>
                        </group>
                        <group string="Measurement">
                            <field name="value"/>
                            <field name="target"/>
                            <field name="unit"/>
                            <field name="rag_status"/>
                            <field name="source"/>
                            <field name="reported_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_sector_kpi_search" model="ir.ui.view">
        <field name="name">albaha.sector.kpi.search</field>
        <field name="model">albaha.sector.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="indicator"/>
                <field name="sector_id"/>
                <field name="period"/>
                <filter string="Economic" name="f_economic" domain="[('domain','=','economic')]"/>
                <filter string="Tourism" name="f_tourism" domain="[('domain','=','tourism')]"/>
                <filter string="Agriculture" name="f_agri" domain="[('domain','=','agriculture')]"/>
                <filter string="Quality of Life" name="f_qol" domain="[('domain','=','qol')]"/>
                <filter string="Investment" name="f_investment" domain="[('domain','=','investment')]"/>
                <group>
                    <filter string="Domain" name="gb_domain" context="{'group_by':'domain'}"/>
                    <filter string="Sector" name="gb_sector" context="{'group_by':'sector_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_sector_kpi" model="ir.actions.act_window">
        <field name="name">Sector KPIs</field>
        <field name="res_model">albaha.sector.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_sector_kpi" name="Sector KPIs" parent="menu_albaha_kpi_root"
              action="action_albaha_sector_kpi" sequence="40"/>
</odoo>
