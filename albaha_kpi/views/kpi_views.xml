<odoo>
    <!-- Form View -->
    <record id="view_albaha_kpi_form" model="ir.ui.view">
        <field name="name">albaha.kpi.form</field>
        <field name="model">albaha.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="name_en"/>
                            <field name="code"/>
                            <field name="kpi_type"/>
                            <field name="unit"/>
                            <field name="description" widget="text"/>
                        </group>
                        <group string="Target &amp; Baseline">
                            <field name="baseline_value"/>
                            <field name="baseline_year"/>
                            <field name="target_value"/>
                            <field name="target_year"/>
                            <field name="frequency"/>
                            <field name="direction"/>
                        </group>
                    </group>
                    <group string="Calculation Details">
                        <field name="formula" widget="text"/>
                    </group>
                </sheet>
                <div class="oe_tail">
                    <field name="value_ids" widget="one2many_tags" options="{'no_create': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_albaha_kpi_tree" model="ir.ui.view">
        <field name="name">albaha.kpi.tree</field>
        <field name="model">albaha.kpi</field>
        <field name="arch" type="xml">
            <list string="KPI Definitions">
                <field name="name"/>
                <field name="code"/>
                <field name="kpi_type"/>
                <field name="unit"/>
                <field name="target_value"/>
                <field name="target_year"/>
                <field name="frequency"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_albaha_kpi_search" model="ir.ui.view">
        <field name="name">albaha.kpi.search</field>
        <field name="model">albaha.kpi</field>
        <field name="arch" type="xml">
            <search string="KPI Search">
                <field name="name"/>
                <field name="code"/>
                <group>
                    <filter string="Type" name="gb_type" context="{'group_by':'kpi_type'}"/>
                    <filter string="Frequency" name="gb_freq" context="{'group_by':'frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and Menu -->
    <record id="action_albaha_kpi" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">albaha.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_kpi_root" name="Al-Baha KPIs" sequence="10"/>
    <menuitem id="menu_albaha_kpi_main" name="KPIs" parent="menu_albaha_kpi_root" action="action_albaha_kpi" sequence="10"/>

</odoo>
