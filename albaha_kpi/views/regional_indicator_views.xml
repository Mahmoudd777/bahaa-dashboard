<odoo>
    <!-- Form View -->
    <record id="view_albaha_regional_indicator_form" model="ir.ui.view">
        <field name="name">albaha.regional.indicator.form</field>
        <field name="model">albaha.regional.indicator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="name_en"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="unit"/>
                        </group>
                        <group string="Values &amp; Targets">
                            <field name="value" widget="monetary"/>
                            <field name="baseline" widget="monetary"/>
                            <field name="target" widget="monetary"/>
                            <field name="trend"/>
                        </group>
                    </group>
                    <group string="Metadata">
                        <field name="source"/>
                        <field name="last_updated"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_albaha_regional_indicator_tree" model="ir.ui.view">
        <field name="name">albaha.regional.indicator.tree</field>
        <field name="model">albaha.regional.indicator</field>
        <field name="arch" type="xml">
            <list string="Regional Indicators">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="value"/>
                <field name="target"/>
                <field name="trend"/>
                <field name="last_updated"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_albaha_regional_indicator_search" model="ir.ui.view">
        <field name="name">albaha.regional.indicator.search</field>
        <field name="model">albaha.regional.indicator</field>
        <field name="arch" type="xml">
            <search string="Regional Indicator Search">
                <group>
                    <filter string="Category" name="by_category" context="{'group_by':'category'}"/>
                    <filter string="Trend" name="by_trend" context="{'group_by':'trend'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and Menu -->
    <record id="action_albaha_regional_indicator" model="ir.actions.act_window">
        <field name="name">Regional Indicators</field>
        <field name="res_model">albaha.regional.indicator</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_regional_indicators" name="Regional Indicators" parent="menu_albaha_kpi_root" action="action_albaha_regional_indicator" sequence="30"/>

</odoo>
