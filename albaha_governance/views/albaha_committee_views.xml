<odoo>
    <record id="view_albaha_committee_list" model="ir.ui.view">
        <field name="name">albaha.committee.list</field>
        <field name="model">albaha.committee</field>
        <field name="arch" type="xml">
            <list string="Committees">
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="tier"/>
                <field name="chair_id"/>
                <field name="member_ids"/>
                <field name="members_count"/>
                <field name="frequency"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_committee_form" model="ir.ui.view">
        <field name="name">albaha.committee.form</field>
        <field name="model">albaha.committee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="name_en"/>
                        <field name="code"/>
                        <field name="tier"/>
                        <field name="chair_id"/>
                        </group>
                        <group>
                        <field name="member_ids"/>
                        <field name="members_count"/>
                        <field name="frequency"/>
                        <field name="status"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <field name="scope" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_committee_search" model="ir.ui.view">
        <field name="name">albaha.committee.search</field>
        <field name="model">albaha.committee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="chair_id"/>
                <group>
                    <filter string="Tier" name="gb_tier" context="{'group_by':'tier'}"/>
                    <filter string="Chair" name="gb_chair_id" context="{'group_by':'chair_id'}"/>
                    <filter string="Frequency" name="gb_frequency" context="{'group_by':'frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_committee" model="ir.actions.act_window">
        <field name="name">Committees</field>
        <field name="res_model">albaha.committee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_committee" name="Committees" parent="menu_albaha_governance_root" action="action_albaha_committee"/>
</odoo>
