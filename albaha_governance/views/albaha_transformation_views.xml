<odoo>
    <record id="view_albaha_transformation_list" model="ir.ui.view">
        <field name="name">albaha.transformation.list</field>
        <field name="model">albaha.transformation</field>
        <field name="arch" type="xml">
            <list string="Transformations">
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="target_year"/>
                <field name="impact_level"/>
                <field name="sponsor_id"/>
                <field name="progress_pct"/>
                <field name="rag_status"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_transformation_form" model="ir.ui.view">
        <field name="name">albaha.transformation.form</field>
        <field name="model">albaha.transformation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="name_en"/>
                        <field name="code"/>
                        <field name="target_year"/>
                        <field name="impact_level"/>
                        </group>
                        <group>
                        <field name="sponsor_id"/>
                        <field name="progress_pct"/>
                        <field name="rag_status"/>
                        <field name="status"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Strategic Value">
                        <field name="strategic_value" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_transformation_search" model="ir.ui.view">
        <field name="name">albaha.transformation.search</field>
        <field name="model">albaha.transformation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="sponsor_id"/>
                <group>
                    <filter string="Impact Level" name="gb_impact_level" context="{'group_by':'impact_level'}"/>
                    <filter string="Sponsor" name="gb_sponsor_id" context="{'group_by':'sponsor_id'}"/>
                    <filter string="Rag Status" name="gb_rag_status" context="{'group_by':'rag_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_transformation" model="ir.actions.act_window">
        <field name="name">Transformations</field>
        <field name="res_model">albaha.transformation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_transformation" name="Transformations" parent="menu_albaha_governance_root" action="action_albaha_transformation"/>
</odoo>
