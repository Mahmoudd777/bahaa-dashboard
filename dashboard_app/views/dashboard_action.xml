<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The OWL dashboard client action. target=current so it renders inside
         the normal web client (Odoo navbar stays visible for internal users,
         who need it to navigate out). Restricted/portal users are locked to it
         via the o_baha_locked body class instead. -->
    <record id="action_dashboard_main" model="ir.actions.client">
        <field name="name">لوحة التحكم</field>
        <field name="tag">dashboard_app.main</field>
        <field name="target">current</field>
    </record>

    <!-- Reachable from the apps menu too (not only as the home action). -->
    <menuitem id="menu_dashboard_root"
              name="لوحة التحكم"
              sequence="1"/>
    <menuitem id="menu_dashboard_main"
              name="لوحة التحكم"
              parent="menu_dashboard_root"
              action="action_dashboard_main"
              sequence="1"/>

</odoo>
