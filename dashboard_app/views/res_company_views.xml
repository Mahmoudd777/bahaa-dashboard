<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the "Website Logo" field right after the standard Logo on the
         company form (Settings > Companies). -->
    <record id="view_company_form_website_logo" model="ir.ui.view">
        <field name="name">res.company.form.website.logo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="logo" position="after">
                <field name="website_logo" widget="image"
                       class="oe_avatar"
                       options="{'preview_image': 'website_logo'}"/>
            </field>
        </field>
    </record>

</odoo>
