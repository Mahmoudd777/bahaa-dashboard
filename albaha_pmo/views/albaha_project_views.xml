<odoo>
    <record id="view_albaha_project_list" model="ir.ui.view">
        <field name="name">albaha.project.list</field>
        <field name="model">albaha.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="project_type"/>
                <field name="manager_id"/>
                <field name="sponsor_id"/>
                <field name="strategic_pillar_id"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_project_form" model="ir.ui.view">
        <field name="name">albaha.project.form</field>
        <field name="model">albaha.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="name_en"/>
                        <field name="code"/>
                        <field name="program_id"/>
                        <field name="project_type"/>
                        <field name="manager_id"/>
                        <field name="sponsor_id"/>
                        <field name="strategic_pillar_id"/>
                        <field name="planned_start"/>
                        <field name="planned_end"/>
                        <field name="actual_start"/>
                        </group>
                        <group>
                        <field name="actual_end"/>
                        <field name="baseline_cost_sar_m"/>
                        <field name="actual_cost_to_date"/>
                        <field name="eac_forecast"/>
                        <field name="progress_pct"/>
                        <field name="planned_pct"/>
                        <field name="health_status"/>
                        <field name="priority"/>
                        <field name="phase"/>
                        <field name="geo_location"/>
                        <field name="last_status_update"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_project_search" model="ir.ui.view">
        <field name="name">albaha.project.search</field>
        <field name="model">albaha.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="program_id"/>
                <group>
                    <filter string="Program Id" name="gb_program_id" context="{'group_by':'program_id'}"/>
                    <filter string="Manager Id" name="gb_manager_id" context="{'group_by':'manager_id'}"/>
                    <filter string="Sponsor Id" name="gb_sponsor_id" context="{'group_by':'sponsor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">albaha.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_project" name="Projects" parent="menu_albaha_pmo_root" action="action_albaha_project"/>
</odoo>
