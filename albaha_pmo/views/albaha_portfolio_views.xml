<odoo>
    <record id="view_albaha_portfolio_list" model="ir.ui.view">
        <field name="name">albaha.portfolio.list</field>
        <field name="model">albaha.portfolio</field>
        <field name="arch" type="xml">
            <list string="Portfolios">
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="portfolio_type"/>
                <field name="fiscal_year"/>
                <field name="total_budget_sar_m"/>
                <field name="sponsor_entity"/>
                <field name="start_date"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_portfolio_form" model="ir.ui.view">
        <field name="name">albaha.portfolio.form</field>
        <field name="model">albaha.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                        <field name="name"/>
                        <field name="name_en"/>
                        <field name="code"/>
                        <field name="portfolio_type"/>
                        <field name="fiscal_year"/>
                        <field name="total_budget_sar_m"/>
                        </group>
                        <group>
                        <field name="sponsor_entity"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="kpi_target_pct"/>
                        <field name="status"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_portfolio_search" model="ir.ui.view">
        <field name="name">albaha.portfolio.search</field>
        <field name="model">albaha.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="portfolio_type"/>
                <group>
                    <filter string="Status" name="gb_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_albaha_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolios</field>
        <field name="res_model">albaha.portfolio</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_albaha_portfolio" name="Portfolios" parent="menu_albaha_pmo_root" action="action_albaha_portfolio"/>
</odoo>
