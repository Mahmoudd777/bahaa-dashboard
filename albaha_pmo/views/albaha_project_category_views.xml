<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_albaha_project_category_list" model="ir.ui.view">
        <field name="name">albaha.project.category.list</field>
        <field name="model">albaha.project.category</field>
        <field name="arch" type="xml">
            <list string="تصنيفات المشاريع">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="tagline"/>
                <field name="color"/>
                <field name="coming_soon"/>
                <field name="project_count"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_project_category_form" model="ir.ui.view">
        <field name="name">albaha.project.category.form</field>
        <field name="model">albaha.project.category</field>
        <field name="arch" type="xml">
            <form string="تصنيف المشاريع">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="tagline"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="icon"/>
                            <field name="coming_soon"/>
                            <field name="active"/>
                            <field name="project_count"/>
                        </group>
                    </group>
                    <group string="الوصف">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="المشاريع">
                        <field name="project_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="progress_pct"/>
                                <field name="health_status"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_albaha_project_category" model="ir.actions.act_window">
        <field name="name">تصنيفات المشاريع</field>
        <field name="res_model">albaha.project.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_albaha_project_category"
              name="تصنيفات المشاريع"
              parent="menu_albaha_pmo_root"
              action="action_albaha_project_category"
              sequence="90"/>

</odoo>
