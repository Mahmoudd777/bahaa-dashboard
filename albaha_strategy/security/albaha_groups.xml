<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Per-model edit rights for the Al-Baha strategy data.

             Read access is granted to every internal user through the module
             ACLs; WRITE/CREATE/DELETE is granted only by joining the editor
             group for that model. That makes "can this user edit KPIs?" a real
             Odoo permission rather than a hidden button, so it holds no matter
             how the record is reached (dashboard, list view, RPC).

             No category_id: Odoo 19 removed that field from res.groups.
             noupdate="1" so a module upgrade never silently re-assigns rights.
        -->
        <record id="group_albaha_edit_objective" model="res.groups">
            <field name="name">تعديل الأهداف الاستراتيجية</field>
        </record>
        <record id="group_albaha_edit_pillar" model="res.groups">
            <field name="name">تعديل الركائز</field>
        </record>
        <record id="group_albaha_edit_program" model="res.groups">
            <field name="name">تعديل البرامج</field>
        </record>
        <record id="group_albaha_edit_kpi" model="res.groups">
            <field name="name">تعديل المؤشرات</field>
        </record>
        <record id="group_albaha_edit_indicator" model="res.groups">
            <field name="name">تعديل المؤشرات الإقليمية</field>
        </record>
        <record id="group_albaha_edit_initiative" model="res.groups">
            <field name="name">تعديل المبادرات</field>
        </record>
        <record id="group_albaha_edit_risk" model="res.groups">
            <field name="name">تعديل المخاطر الاستراتيجية</field>
        </record>
        <record id="group_albaha_edit_decision" model="res.groups">
            <field name="name">تعديل القرارات</field>
        </record>
        <record id="group_albaha_edit_steerco" model="res.groups">
            <field name="name">تعديل قرارات اللجان</field>
        </record>
    </data>
</odoo>
