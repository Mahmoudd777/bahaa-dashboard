<odoo>
    <record id="view_albaha_pillar_form" model="ir.ui.view">
        <field name="name">albaha.pillar.form</field>
        <field name="model">albaha.pillar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="status"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="description" widget="text"/>
                            <field name="color_hex"/>
                            <field name="vision_2030_link"/>
                            <field name="owner_office"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objectives">
                            <field name="objective_ids" widget="one2many_tags"/>
                        </page>
                        <page string="Programs">
                            <field name="program_ids" widget="one2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_pillar_list" model="ir.ui.view">
        <field name="name">albaha.pillar.list</field>
        <field name="model">albaha.pillar</field>
        <field name="arch" type="xml">
            <list string="Pillars">
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <field name="sequence"/>
                <field name="owner_office"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_pillar_search" model="ir.ui.view">
        <field name="name">albaha.pillar.search</field>
        <field name="model">albaha.pillar</field>
        <field name="arch" type="xml">
            <search>
                <group/>
                <filter string="Active" name="active_filter" domain="[('status', '=', 'active')]"/>
                <filter string="On Hold" name="onhold_filter" domain="[('status', '=', 'onhold')]"/>
                <filter string="Closed" name="closed_filter" domain="[('status', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_albaha_pillar" model="ir.actions.act_window">
        <field name="name">Pillars</field>
        <field name="res_model">albaha.pillar</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_albaha_root" name="Al-Baha Strategy" sequence="10"/>
    <menuitem 
        id="menu_albaha_pillar" 
        name="Pillars" 
        parent="menu_albaha_root" 
        action="action_albaha_pillar" 
        sequence="10"/>
</odoo>
