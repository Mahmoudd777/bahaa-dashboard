<odoo>
    <record id="view_albaha_program_form" model="ir.ui.view">
        <field name="name">albaha.program.form</field>
        <field name="model">albaha.program</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="status"/>
                            <field name="pillar_id"/>
                        </group>
                        <group>
                            <field name="description" widget="text"/>
                            <field name="color_hex"/>
                        </group>
                    </group>
                    <group string="Timeline &amp; Budget">
                        <group>
                            <field name="total_budget_sar_m"/>
                            <field name="initiatives_count"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Ownership">
                        <field name="lead_owner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_program_list" model="ir.ui.view">
        <field name="name">albaha.program.list</field>
        <field name="model">albaha.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="name"/>
                <field name="code"/>
                <field name="pillar_id"/>
                <field name="status"/>
                <field name="total_budget_sar_m"/>
                <field name="start_date"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_program_search" model="ir.ui.view">
        <field name="name">albaha.program.search</field>
        <field name="model">albaha.program</field>
        <field name="arch" type="xml">
            <search>
                <group/>
                <filter string="Active" name="active_filter" domain="[('status', '=', 'active')]"/>
                <filter string="On Hold" name="onhold_filter" domain="[('status', '=', 'onhold')]"/>
                <filter string="Closed" name="closed_filter" domain="[('status', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_albaha_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">albaha.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem 
        id="menu_albaha_program" 
        name="Programs" 
        parent="menu_albaha_root" 
        action="action_albaha_program" 
        sequence="30"/>
</odoo>
