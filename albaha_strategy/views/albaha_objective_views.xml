<odoo>
    <record id="view_albaha_objective_form" model="ir.ui.view">
        <field name="name">albaha.objective.form</field>
        <field name="model">albaha.objective</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="status"/>
                            <field name="pillar_id"/>
                        </group>
                        <group>
                            <field name="description" widget="text"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <group string="Metrics">
                        <group>
                            <field name="target_value"/>
                            <field name="unit"/>
                            <field name="baseline_value"/>
                        </group>
                        <group>
                            <field name="weight_pct"/>
                            <field name="target_year"/>
                            <field name="sponsor"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_albaha_objective_list" model="ir.ui.view">
        <field name="name">albaha.objective.list</field>
        <field name="model">albaha.objective</field>
        <field name="arch" type="xml">
            <list string="Objectives">
                <field name="name"/>
                <field name="code"/>
                <field name="pillar_id"/>
                <field name="status"/>
                <field name="target_value"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="view_albaha_objective_search" model="ir.ui.view">
        <field name="name">albaha.objective.search</field>
        <field name="model">albaha.objective</field>
        <field name="arch" type="xml">
            <search>
                <group/>
                <filter string="Active" name="active_filter" domain="[('status', '=', 'active')]"/>
                <filter string="On Hold" name="onhold_filter" domain="[('status', '=', 'onhold')]"/>
                <filter string="Closed" name="closed_filter" domain="[('status', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_albaha_objective" model="ir.actions.act_window">
        <field name="name">Objectives</field>
        <field name="res_model">albaha.objective</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem 
        id="menu_albaha_objective" 
        name="Objectives" 
        parent="menu_albaha_root" 
        action="action_albaha_objective" 
        sequence="20"/>
</odoo>
